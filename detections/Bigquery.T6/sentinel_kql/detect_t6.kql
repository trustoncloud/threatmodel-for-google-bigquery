let lookback = 1h;
let authorized_buckets = dynamic(["authorized-export-bucket-1", "authorized-export-bucket-2"]);
GCPAuditLogs_CL
| where TimeGenerated > ago(lookback)
| where serviceName_s == "bigquery.googleapis.com"
